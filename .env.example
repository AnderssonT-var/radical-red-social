# Variables de entorno de RADICAL (en Hostinger: panel de la app → "Environment variables")
NODE_ENV=production
# Carpeta FUERA de la app (se conserva al volver a desplegar). Ej.: /home/u123456789/radical-data
DATA_DIR=/home/uXXXXXXXXX/radical-data
UPLOADS_DIR=/home/uXXXXXXXXX/radical-data/uploads
# Opcional: clave larga y aleatoria para firmar sesiones (si no se define, se genera una y se guarda en DATA_DIR)
JWT_SECRET=
# Zona horaria del gimnasio (define el "día" para rachas y asistencias)
TZ_GYM=America/Guayaquil
# Solo para PROBAR: carga usuarios, publicaciones, retos y rankings de ejemplo la primera vez (contraseña: radical123)
# RADICAL_DEMO=1
# Alternativa a "el primer registro es el dueño": crear el dueño automáticamente
# OWNER_EMAIL=tu@correo.com
# OWNER_PASSWORD=ClaveSegura123
# OWNER_NAME=Tu Nombre
# Opcional: correo para recuperar contraseña (cuenta de correo creada en Hostinger)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=no-responder@tudominio.com
# SMTP_PASS=
